{
  "name": "collegenotes-11-11",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CollegeNotes{11:11} — local learning workspace",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.21.0",
    "npm": "12.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "npm run build -w @collegenotes/web && npm run build -w @collegenotes/local-service",
    "check:types": "tsc -b --pretty false && tsc --noEmit -p apps/web/tsconfig.json",
    "check:lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project e2e",
    "test:accessibility": "playwright test --project accessibility",
    "test:evals": "vitest run --project evals",
    "verify:step": "node scripts/verify-step.mjs",
    "verify:planning": "node scripts/validate-project.mjs",
    "test:workflow": "node scripts/rehearse-workflow.mjs",
    "audit:deps": "npm audit --json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
